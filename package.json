{
  "name": "searchdata",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "docx": "^9.15.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
